{"id": "PN-T03-Q028", "oposicion": "policia-nacional", "tema": 3, "punto": 14, "subpunto": "14.2", "concepto": "control judicial de la Administración", "norma": "Constitución Española", "articulo": "106", "dificultad": "media", "tipo": "literal", "enunciado": "Los tribunales controlan:", "opciones": {"A": "La potestad reglamentaria y la legalidad de la actuación administrativa", "B": "La oportunidad política de cada decisión parlamentaria", "C": "La sucesión a la Corona"}, "respuesta_correcta": "A", "explicacion": "El control jurisdiccional administrativo está previsto en el artículo 106.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q029", "oposicion": "policia-nacional", "tema": 3, "punto": 15, "subpunto": "15.1", "concepto": "responsabilidad política", "norma": "Constitución Española", "articulo": "108", "dificultad": "básica", "tipo": "literal", "enunciado": "El Gobierno responde solidariamente de su gestión política ante:", "opciones": {"A": "El Senado", "B": "El Congreso de los Diputados", "C": "El Tribunal Supremo"}, "respuesta_correcta": "B", "explicacion": "La responsabilidad política solidaria se exige ante el Congreso.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q030", "oposicion": "policia-nacional", "tema": 3, "punto": 15, "subpunto": "15.2", "concepto": "cuestión de confianza", "norma": "Constitución Española", "articulo": "112-113", "dificultad": "media", "tipo": "trampa", "enunciado": "La confianza se entiende otorgada cuando vote a favor:", "opciones": {"A": "La mayoría absoluta del Senado", "B": "Tres quintos del Congreso", "C": "La mayoría simple de los diputados"}, "respuesta_correcta": "C", "explicacion": "La cuestión de confianza requiere mayoría simple.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q031", "oposicion": "policia-nacional", "tema": 3, "punto": 16, "subpunto": "16.1", "concepto": "moción de censura", "norma": "Constitución Española", "articulo": "113", "dificultad": "básica", "tipo": "literal", "enunciado": "La moción de censura debe incluir:", "opciones": {"A": "Un candidato a la Presidencia del Gobierno", "B": "Una propuesta de disolución de las Cortes", "C": "La firma de la mayoría absoluta de senadores"}, "respuesta_correcta": "A", "explicacion": "La censura española es constructiva.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q032", "oposicion": "policia-nacional", "tema": 3, "punto": 16, "subpunto": "16.2", "concepto": "plazo de moción de censura", "norma": "Constitución Española", "articulo": "113.3", "dificultad": "media", "tipo": "numérica", "enunciado": "La moción de censura no puede votarse hasta que transcurran:", "opciones": {"A": "Cuarenta y ocho horas", "B": "Cinco días desde su presentación", "C": "Quince días"}, "respuesta_correcta": "B", "explicacion": "El plazo mínimo constitucional es de cinco días.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q033", "oposicion": "policia-nacional", "tema": 3, "punto": 17, "subpunto": "17.1", "concepto": "estado de alarma", "norma": "LO 4/1981", "articulo": "4-12", "dificultad": "básica", "tipo": "literal", "enunciado": "El estado de alarma es declarado inicialmente por:", "opciones": {"A": "El Congreso por mayoría absoluta", "B": "El Rey previa autorización del Senado", "C": "El Gobierno mediante decreto acordado en Consejo de Ministros"}, "respuesta_correcta": "C", "explicacion": "La declaración inicial corresponde al Gobierno y dura hasta 15 días.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q034", "oposicion": "policia-nacional", "tema": 3, "punto": 17, "subpunto": "17.2", "concepto": "estado de sitio", "norma": "Constitución Española", "articulo": "116.4", "dificultad": "media", "tipo": "trampa", "enunciado": "El estado de sitio lo declara:", "opciones": {"A": "El Congreso por mayoría absoluta, a propuesta exclusiva del Gobierno", "B": "El Gobierno, dando cuenta al Congreso", "C": "El Senado por tres quintos"}, "respuesta_correcta": "A", "explicacion": "Es el estado con mayor intervención parlamentaria.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q035", "oposicion": "policia-nacional", "tema": 3, "punto": 18, "subpunto": "18.1", "concepto": "principios judiciales", "norma": "Constitución Española", "articulo": "117", "dificultad": "básica", "tipo": "literal", "enunciado": "Los jueces y magistrados están sometidos únicamente:", "opciones": {"A": "A las instrucciones del Gobierno", "B": "Al imperio de la ley", "C": "A la jurisprudencia del Tribunal Constitucional"}, "respuesta_correcta": "B", "explicacion": "La independencia judicial se expresa mediante la sumisión exclusiva al imperio de la ley.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q036", "oposicion": "policia-nacional", "tema": 3, "punto": 18, "subpunto": "18.2", "concepto": "unidad jurisdiccional", "norma": "Constitución Española", "articulo": "117.5-6", "dificultad": "media", "tipo": "trampa", "enunciado": "La Constitución:", "opciones": {"A": "Permite tribunales de excepción por decreto-ley", "B": "Subordina la jurisdicción ordinaria al Gobierno", "C": "Prohíbe los tribunales de excepción"}, "respuesta_correcta": "C", "explicacion": "La unidad jurisdiccional es base organizativa y se prohíben tribunales de excepción.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q037", "oposicion": "policia-nacional", "tema": 3, "punto": 19, "subpunto": "19.1", "concepto": "CGPJ", "norma": "Constitución Española", "articulo": "122", "dificultad": "básica", "tipo": "conceptual", "enunciado": "El Consejo General del Poder Judicial es:", "opciones": {"A": "El órgano de gobierno del Poder Judicial", "B": "El órgano jurisdiccional superior en todos los órdenes", "C": "Una sala del Tribunal Constitucional"}, "respuesta_correcta": "A", "explicacion": "No ejerce jurisdicción: es el órgano de gobierno judicial.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q038", "oposicion": "policia-nacional", "tema": 3, "punto": 19, "subpunto": "19.2", "concepto": "Ministerio Fiscal", "norma": "Constitución Española", "articulo": "124", "dificultad": "media", "tipo": "trampa", "enunciado": "El Ministerio Fiscal actúa conforme a los principios de:", "opciones": {"A": "Independencia e inamovilidad", "B": "Unidad de actuación y dependencia jerárquica", "C": "Autonomía territorial y oportunidad política"}, "respuesta_correcta": "B", "explicacion": "Estos principios se combinan con legalidad e imparcialidad.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q039", "oposicion": "policia-nacional", "tema": 3, "punto": 20, "subpunto": "20.1", "concepto": "dependencia funcional de Policía Judicial", "norma": "Constitución Española", "articulo": "126", "dificultad": "básica", "tipo": "literal", "enunciado": "En sus funciones de averiguación del delito, la Policía Judicial depende de:", "opciones": {"A": "Exclusivamente del Ministro del Interior", "B": "Las Cortes Generales", "C": "Jueces, tribunales y Ministerio Fiscal"}, "respuesta_correcta": "C", "explicacion": "Es una dependencia funcional específica del artículo 126.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q040", "oposicion": "policia-nacional", "tema": 3, "punto": 20, "subpunto": "20.2", "concepto": "doble dependencia policial", "norma": "Constitución Española", "articulo": "104 y 126", "dificultad": "alta", "tipo": "conceptual", "enunciado": "La dependencia funcional de Policía Judicial:", "opciones": {"A": "Convive con la dependencia orgánica policial", "B": "Elimina toda dependencia orgánica", "C": "Solo existe durante el estado de sitio"}, "respuesta_correcta": "A", "explicacion": "La función judicial no borra la estructura orgánica del cuerpo policial.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q041", "oposicion": "policia-nacional", "tema": 3, "punto": 21, "subpunto": "21.1", "concepto": "organización territorial", "norma": "Constitución Española", "articulo": "137", "dificultad": "básica", "tipo": "literal", "enunciado": "El Estado se organiza territorialmente en:", "opciones": {"A": "Comarcas, regiones y nacionalidades", "B": "Municipios, provincias y comunidades autónomas que se constituyan", "C": "Municipios y comunidades autónomas exclusivamente"}, "respuesta_correcta": "B", "explicacion": "Es la enumeración literal del artículo 137.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q042", "oposicion": "policia-nacional", "tema": 3, "punto": 21, "subpunto": "21.2", "concepto": "solidaridad territorial", "norma": "Constitución Española", "articulo": "138-139", "dificultad": "media", "tipo": "trampa", "enunciado": "Las diferencias entre Estatutos de Autonomía:", "opciones": {"A": "Pueden crear privilegios fiscales ilimitados", "B": "Eliminan la igualdad de derechos entre españoles", "C": "No pueden implicar privilegios económicos o sociales"}, "respuesta_correcta": "C", "explicacion": "La autonomía se concilia con solidaridad e igualdad.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q043", "oposicion": "policia-nacional", "tema": 3, "punto": 22, "subpunto": "22.1", "concepto": "leyes de armonización", "norma": "Constitución Española", "articulo": "150.3", "dificultad": "alta", "tipo": "literal", "enunciado": "La necesidad de dictar una ley de armonización debe apreciarse por:", "opciones": {"A": "Las Cortes Generales por mayoría absoluta de cada Cámara", "B": "El Gobierno por decreto-ley", "C": "El Congreso por mayoría simple sin intervención del Senado"}, "respuesta_correcta": "A", "explicacion": "Es una garantía reforzada y bicameral del artículo 150.3.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q044", "oposicion": "policia-nacional", "tema": 3, "punto": 22, "subpunto": "22.2", "concepto": "técnicas del artículo 150", "norma": "Constitución Española", "articulo": "150", "dificultad": "alta", "tipo": "comparación", "enunciado": "¿Cuál NO es una técnica del artículo 150?", "opciones": {"A": "Las leyes marco", "B": "La aplicación de medidas coercitivas a una comunidad autónoma", "C": "Las leyes orgánicas de transferencia o delegación"}, "respuesta_correcta": "B", "explicacion": "Las medidas coercitivas pertenecen al artículo 155, no al 150.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q045", "oposicion": "policia-nacional", "tema": 3, "punto": 23, "subpunto": "23.1", "concepto": "control autonómico", "norma": "Constitución Española", "articulo": "153", "dificultad": "media", "tipo": "literal", "enunciado": "El control de la constitucionalidad de disposiciones normativas autonómicas con fuerza de ley corresponde a:", "opciones": {"A": "El Tribunal de Cuentas", "B": "El Gobierno", "C": "El Tribunal Constitucional"}, "respuesta_correcta": "C", "explicacion": "El artículo 153 distribuye controles según su naturaleza.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q046", "oposicion": "policia-nacional", "tema": 3, "punto": 23, "subpunto": "23.2", "concepto": "artículo 155", "norma": "Constitución Española", "articulo": "155", "dificultad": "alta", "tipo": "trampa", "enunciado": "Para aplicar el artículo 155 se requiere, entre otros elementos:", "opciones": {"A": "Requerimiento previo al presidente autonómico y mayoría absoluta del Senado", "B": "Mayoría absoluta del Congreso sin requerimiento", "C": "Autorización del Tribunal Supremo"}, "respuesta_correcta": "A", "explicacion": "La intervención exige requerimiento previo y aprobación del Senado.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q047", "oposicion": "policia-nacional", "tema": 3, "punto": 24, "subpunto": "24.1", "concepto": "composición del TC", "norma": "Constitución Española", "articulo": "159", "dificultad": "básica", "tipo": "numérica", "enunciado": "El Tribunal Constitucional está compuesto por:", "opciones": {"A": "Veinte vocales", "B": "Doce miembros", "C": "Quince magistrados"}, "respuesta_correcta": "B", "explicacion": "La composición constitucional es de 12 miembros.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q048", "oposicion": "policia-nacional", "tema": 3, "punto": 24, "subpunto": "24.2", "concepto": "mandato del TC", "norma": "Constitución Española", "articulo": "159.3", "dificultad": "media", "tipo": "trampa", "enunciado": "Los miembros del Tribunal Constitucional son designados por:", "opciones": {"A": "Cinco años, renovándose por mitades", "B": "Seis años, sin renovación parcial", "C": "Nueve años, renovándose por tercios cada tres"}, "respuesta_correcta": "C", "explicacion": "No debe confundirse con el mandato del CGPJ.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q049", "oposicion": "policia-nacional", "tema": 3, "punto": 25, "subpunto": "25.1", "concepto": "cuestión de inconstitucionalidad", "norma": "Constitución Española", "articulo": "163", "dificultad": "media", "tipo": "literal", "enunciado": "¿Quién plantea una cuestión de inconstitucionalidad?", "opciones": {"A": "Un órgano judicial en un proceso", "B": "Cualquier ciudadano directamente", "C": "El Gobierno mediante real decreto"}, "respuesta_correcta": "A", "explicacion": "La cuestión nace en un proceso judicial cuando la validez de la ley es relevante para el fallo.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q050", "oposicion": "policia-nacional", "tema": 3, "punto": 25, "subpunto": "25.2", "concepto": "reforma agravada", "norma": "Constitución Española", "articulo": "168", "dificultad": "alta", "tipo": "secuencia", "enunciado": "La reforma agravada exige, entre otros trámites:", "opciones": {"A": "Tres quintos y referéndum solo si lo pide una décima parte", "B": "Dos tercios, disolución, nueva aprobación por dos tercios y referéndum", "C": "Mayoría absoluta del Congreso y del Senado"}, "respuesta_correcta": "B", "explicacion": "Es el procedimiento del artículo 168 para materias especialmente protegidas.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
