{"id": "PN-T03-Q001", "oposicion": "policia-nacional", "tema": 3, "punto": 1, "subpunto": "1.1", "concepto": "posición constitucional del Rey", "norma": "Constitución Española", "articulo": "56.1", "dificultad": "básica", "tipo": "literal", "enunciado": "¿Qué condición atribuye la Constitución al Rey?", "opciones": {"A": "Es el Jefe del Estado, símbolo de su unidad y permanencia", "B": "Es el titular de la potestad ejecutiva", "C": "Es el presidente nato de las Cortes Generales"}, "respuesta_correcta": "A", "explicacion": "El artículo 56.1 define al Rey como Jefe del Estado y símbolo de su unidad y permanencia.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q002", "oposicion": "policia-nacional", "tema": 3, "punto": 1, "subpunto": "1.2", "concepto": "refrendo", "norma": "Constitución Española", "articulo": "64", "dificultad": "media", "tipo": "trampa", "enunciado": "¿Quién responde de los actos del Rey sometidos a refrendo?", "opciones": {"A": "El propio Rey", "B": "La persona que los refrenda", "C": "El Tribunal Constitucional"}, "respuesta_correcta": "B", "explicacion": "La inviolabilidad regia desplaza la responsabilidad a quien refrenda el acto.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q003", "oposicion": "policia-nacional", "tema": 3, "punto": 2, "subpunto": "2.1", "concepto": "funciones del Rey", "norma": "Constitución Española", "articulo": "62", "dificultad": "básica", "tipo": "literal", "enunciado": "¿Cuál de estas funciones corresponde al Rey?", "opciones": {"A": "Aprobar los Presupuestos Generales del Estado", "B": "Ejercer la potestad reglamentaria", "C": "Sancionar y promulgar las leyes"}, "respuesta_correcta": "C", "explicacion": "La sanción y promulgación corresponden al Rey; las otras funciones pertenecen a Cortes y Gobierno.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q004", "oposicion": "policia-nacional", "tema": 3, "punto": 2, "subpunto": "2.2", "concepto": "nombramiento de ministros", "norma": "Constitución Española", "articulo": "62.e", "dificultad": "media", "tipo": "trampa", "enunciado": "El Rey nombra y separa a los miembros del Gobierno:", "opciones": {"A": "A propuesta de su Presidente", "B": "Libremente", "C": "A propuesta del Congreso de los Diputados"}, "respuesta_correcta": "A", "explicacion": "El artículo 62.e exige propuesta del Presidente del Gobierno.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q005", "oposicion": "policia-nacional", "tema": 3, "punto": 3, "subpunto": "3.1", "concepto": "sucesión a la Corona", "norma": "Constitución Española", "articulo": "57", "dificultad": "media", "tipo": "literal", "enunciado": "En el orden sucesorio, dentro del mismo grado, la Constitución vigente prefiere:", "opciones": {"A": "La mujer al varón", "B": "El varón a la mujer", "C": "Siempre a la persona de menor edad"}, "respuesta_correcta": "B", "explicacion": "La preferencia del varón sobre la mujer dentro del mismo grado continúa en el texto vigente.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q006", "oposicion": "policia-nacional", "tema": 3, "punto": 3, "subpunto": "3.2", "concepto": "regencia", "norma": "Constitución Española", "articulo": "59", "dificultad": "media", "tipo": "trampa", "enunciado": "La Regencia se ejerce:", "opciones": {"A": "Por delegación del Gobierno y en nombre de las Cortes", "B": "Por elección popular y en nombre propio", "C": "Por mandato constitucional y en nombre del Rey"}, "respuesta_correcta": "C", "explicacion": "La Regencia no sustituye la titularidad de la Corona: actúa por mandato constitucional y en nombre del Rey.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q007", "oposicion": "policia-nacional", "tema": 3, "punto": 4, "subpunto": "4.1", "concepto": "funciones de las Cortes", "norma": "Constitución Española", "articulo": "66", "dificultad": "básica", "tipo": "negativa", "enunciado": "¿Cuál NO es una función constitucional de las Cortes Generales?", "opciones": {"A": "Dirigir la política interior y exterior", "B": "Ejercer la potestad legislativa", "C": "Controlar la acción del Gobierno"}, "respuesta_correcta": "A", "explicacion": "La dirección política corresponde al Gobierno; las Cortes legislan, aprueban presupuestos y controlan.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q008", "oposicion": "policia-nacional", "tema": 3, "punto": 4, "subpunto": "4.2", "concepto": "estructura de las Cortes", "norma": "Constitución Española", "articulo": "66", "dificultad": "básica", "tipo": "literal", "enunciado": "Las Cortes Generales están formadas por:", "opciones": {"A": "El Congreso y el Consejo de Estado", "B": "El Congreso de los Diputados y el Senado", "C": "El Senado y el Tribunal Constitucional"}, "respuesta_correcta": "B", "explicacion": "La Constitución configura unas Cortes bicamerales.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q009", "oposicion": "policia-nacional", "tema": 3, "punto": 5, "subpunto": "5.1", "concepto": "composición del Congreso", "norma": "Constitución Española", "articulo": "68", "dificultad": "media", "tipo": "trampa", "enunciado": "Según la Constitución, el Congreso se compone de:", "opciones": {"A": "Exactamente 350 diputados", "B": "Un mínimo de 250 y un máximo de 350 diputados", "C": "Un mínimo de 300 y un máximo de 400 diputados"}, "respuesta_correcta": "C", "explicacion": "La CE fija la horquilla 300-400; la LOREG concreta actualmente 350.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q010", "oposicion": "policia-nacional", "tema": 3, "punto": 5, "subpunto": "5.2", "concepto": "representación territorial del Senado", "norma": "Constitución Española", "articulo": "69", "dificultad": "básica", "tipo": "literal", "enunciado": "¿Cuántos senadores se eligen en cada provincia, con carácter general?", "opciones": {"A": "Cuatro", "B": "Dos", "C": "Uno por cada millón de habitantes"}, "respuesta_correcta": "A", "explicacion": "La regla general provincial es cuatro; la regla poblacional indicada corresponde a la designación autonómica.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q011", "oposicion": "policia-nacional", "tema": 3, "punto": 6, "subpunto": "6.1", "concepto": "inmunidad parlamentaria", "norma": "Constitución Española", "articulo": "71", "dificultad": "media", "tipo": "literal", "enunciado": "Durante su mandato, diputados y senadores solo pueden ser detenidos:", "opciones": {"A": "Con autorización del Gobierno", "B": "En caso de flagrante delito", "C": "Por cualquier delito castigado con prisión"}, "respuesta_correcta": "B", "explicacion": "La inmunidad parlamentaria limita la detención al supuesto de flagrante delito.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q012", "oposicion": "policia-nacional", "tema": 3, "punto": 6, "subpunto": "6.2", "concepto": "aforamiento parlamentario", "norma": "Constitución Española", "articulo": "71.3", "dificultad": "media", "tipo": "trampa", "enunciado": "En las causas contra diputados y senadores es competente:", "opciones": {"A": "La Audiencia Nacional", "B": "El Tribunal Constitucional", "C": "La Sala de lo Penal del Tribunal Supremo"}, "respuesta_correcta": "C", "explicacion": "El aforamiento parlamentario se atribuye a la Sala Segunda del Tribunal Supremo.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q013", "oposicion": "policia-nacional", "tema": 3, "punto": 7, "subpunto": "7.1", "concepto": "periodos ordinarios de sesiones", "norma": "Constitución Española", "articulo": "73", "dificultad": "básica", "tipo": "literal", "enunciado": "Los períodos ordinarios de sesiones son:", "opciones": {"A": "De septiembre a diciembre y de febrero a junio", "B": "De enero a junio y de septiembre a noviembre", "C": "De septiembre a enero y de marzo a julio"}, "respuesta_correcta": "A", "explicacion": "Son dos períodos: septiembre-diciembre y febrero-junio.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
