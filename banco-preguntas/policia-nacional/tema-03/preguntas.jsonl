{"id": "PN-T03-Q025", "oposicion": "policia-nacional", "tema": 3, "punto": 13, "subpunto": "13.1", "concepto": "investidura", "norma": "Constitución Española", "articulo": "99", "dificultad": "media", "tipo": "secuencia", "enunciado": "Si el candidato no obtiene mayoría absoluta en primera votación, la segunda se celebra:", "opciones": {"A": "Cuarenta y ocho horas después y basta mayoría simple", "B": "Cinco días después y exige mayoría absoluta", "C": "Veinticuatro horas después y exige tres quintos"}, "respuesta_correcta": "A", "explicacion": "Es la secuencia exacta del artículo 99.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
