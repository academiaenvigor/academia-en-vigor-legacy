{"id": "PN-T03-Q015", "oposicion": "policia-nacional", "tema": 3, "punto": 8, "subpunto": "8.1", "concepto": "ley orgánica", "norma": "Constitución Española", "articulo": "81.2", "dificultad": "media", "tipo": "literal", "enunciado": "La aprobación de una ley orgánica exige:", "opciones": {"A": "Mayoría de tres quintos de cada Cámara", "B": "Mayoría simple del Congreso y del Senado", "C": "Mayoría absoluta del Congreso en votación final sobre el conjunto"}, "respuesta_correcta": "C", "explicacion": "La exigencia es mayoría absoluta del Congreso en una votación final sobre el conjunto.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q016", "oposicion": "policia-nacional", "tema": 3, "punto": 8, "subpunto": "8.2", "concepto": "delegación legislativa", "norma": "Constitución Española", "articulo": "82", "dificultad": "media", "tipo": "trampa", "enunciado": "La delegación legislativa al Gobierno debe otorgarse:", "opciones": {"A": "De forma expresa, para materia concreta y con plazo", "B": "De forma tácita y por tiempo indefinido", "C": "Mediante decreto-ley del propio Gobierno"}, "respuesta_correcta": "A", "explicacion": "La delegación no puede presumirse ni ser indefinida.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q017", "oposicion": "policia-nacional", "tema": 3, "punto": 9, "subpunto": "9.1", "concepto": "decreto legislativo", "norma": "Constitución Española", "articulo": "85", "dificultad": "básica", "tipo": "literal", "enunciado": "Las disposiciones del Gobierno que contienen legislación delegada reciben el título de:", "opciones": {"A": "Decretos-leyes", "B": "Decretos legislativos", "C": "Reglamentos ejecutivos"}, "respuesta_correcta": "B", "explicacion": "Es la denominación expresa del artículo 85.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q018", "oposicion": "policia-nacional", "tema": 3, "punto": 9, "subpunto": "9.2", "concepto": "decreto-ley", "norma": "Constitución Española", "articulo": "86", "dificultad": "media", "tipo": "numérica", "enunciado": "Un decreto-ley debe someterse al Congreso para convalidación o derogación en:", "opciones": {"A": "Quince días", "B": "Dos meses", "C": "Treinta días"}, "respuesta_correcta": "C", "explicacion": "El Congreso debe pronunciarse dentro de los 30 días siguientes a su promulgación.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q019", "oposicion": "policia-nacional", "tema": 3, "punto": 10, "subpunto": "10.1", "concepto": "iniciativa legislativa popular", "norma": "Constitución Española", "articulo": "87.3", "dificultad": "básica", "tipo": "numérica", "enunciado": "La iniciativa legislativa popular requiere al menos:", "opciones": {"A": "500.000 firmas acreditadas", "B": "100.000 firmas", "C": "1.000.000 de firmas"}, "respuesta_correcta": "A", "explicacion": "El umbral constitucional es de 500.000 firmas acreditadas.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
{"id": "PN-T03-Q020", "oposicion": "policia-nacional", "tema": 3, "punto": 10, "subpunto": "10.2", "concepto": "tramitación en el Senado", "norma": "Constitución Española", "articulo": "90", "dificultad": "media", "tipo": "trampa", "enunciado": "En un proyecto declarado urgente, el Senado dispone de:", "opciones": {"A": "Treinta días hábiles", "B": "Veinte días naturales", "C": "Quince días naturales"}, "respuesta_correcta": "B", "explicacion": "El plazo ordinario de dos meses se reduce a veinte días naturales.", "estado_revision": "revisado_editorial", "version_normativa": "2026-07-16", "caracter": "propio", "referencia_oficial": null, "relaciones": [], "equivalencias": [], "content_version": "0.2.0"}
